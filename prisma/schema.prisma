// Prisma schema — SQLite (modo WAL activado en runtime, ver PrismaService).
// Nota: el schema anterior (Postgres, con Usuario/Consulta/Anamnesis/...) no estaba
// conectado a ningún módulo real de la app (no había PrismaModule/PrismaService en src),
// por lo que se reemplaza por el mínimo necesario para la orden de cobro.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos en Prisma, por eso paymentStatus / generationStatus
// se modelan como String y se tipan a nivel de aplicación (ver src/domain/dtos/order.dto.ts).

model Order {
  id                String   @id @default(uuid())
  email             String   @map("correo")
  payloadJson       String?  @map("payload_json") // ConsultaCompletaDto completo (personalInfo + anamnesis + measurements)
  paymentStatus     String   @default("pendiente") @map("estado_pago") // 'pendiente' | 'pagado'
  generationStatus  String   @default("no_iniciado") @map("estado_generacion") // 'no_iniciado' | 'generando' | 'completado' | 'error'
  planJson          String?  @map("plan_json") // PlanNutricionalDto resultante, null hasta que se genera
  attempts          Int      @default(0) @map("intentos")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@map("orden")
}
