
PORT=3001
# Origen permitido por CORS. Obligatoria en producción.
URL_FRONTEND=http://localhost:3000
DATABASE_URL="postgresql://fitplan:fitplan@localhost:5432/fitplan?schema=public"

# production deshabilita Swagger y exige URL_FRONTEND
NODE_ENV=development

# Documentación de la API en /api-docs. Solo fuera de producción y solo con true.
ENABLE_SWAGGER=false

# Validación de JWT de Cognito (access_token) para los guards de presentation/auth/. Deben
# apuntar al mismo User Pool / App Client que usa el frontend (COGNITO_CLIENT_ID = el mismo
# valor que COGNITO_CLIENT_ID del .env del frontend).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Usuario IAM con permisos CRUD/list sobre el bucket S3 donde se almacenan los PDFs de los
# planes nutricionales (carpetas productos-personalizados/ y productos-estandarizados/).
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Pasarela de pago: Webpay Plus de Transbank.
# TRANSBANK_ENVIRONMENT: `integration` (ambiente de pruebas de Transbank, por defecto) o `production`.
# En integration, sin código de comercio ni API key se usan las credenciales públicas de prueba del
# SDK. En production las tres variables siguientes son obligatorias (el backend no arranca sin ellas).
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
# URL del frontend a la que Webpay devuelve al usuario después de pagar (route handler
# /api/webpay/return). Por defecto http://localhost:3000/api/webpay/return.
WEBPAY_RETURN_URL=http://localhost:3000/api/webpay/return

# Habilita POST /api/v1/dev/orders/:id/simulate-payment[-rejection] (pago simulado, sin pasar por
# Webpay): solo para desarrollo y pruebas. En producción debe ir en false. Con cualquier valor
# distinto de true los endpoints responden 404. Exigen la sesión del usuario dueño de la orden.
ENABLE_PAYMENT_SIMULATION=true

# Opcional: tope (ms) de las llamadas al modelo dentro de una request (chat de anamnesis,
# factibilidad). Por defecto 60000.
OPENAI_TIMEOUT_MS=
# Opcional: tope (ms) de la llamada que genera el plan (tarda minutos). Por defecto 300000. Con 4
# intentos por ronda, no subirlo de ~6 min: la ronda debe terminar antes de los 30 min en que el job
# de reintentos la da por interrumpida.
OPENAI_PLAN_TIMEOUT_MS=

# true muestra en el log cuánto tarda cada fase de la generación del plan (para detectar cuellos de
# botella). Con cualquier otro valor esos logs no se emiten.
PLAN_GENERATION_TIMING_LOGS=false
