
PORT=3001
URL_FRONTEND=http://localhost:3000
EMAIL=cberna.alvaro@gmail.com
DATABASE_URL="postgresql://nutricionista:nutricionista@localhost:5432/nutricionista_virtual?schema=public"

JWT_ACCESS_SECRET="una_clave_muuy_segura_access"
JWT_REFRESH_SECRET="otra_clave_muuy_segura_refresh"
JWT_ACCESS_EXPIRATION="9000s"   # 150 minutes
JWT_REFRESH_EXPIRATION="7d"    # 7 days
BCRYPT_SALT_OR_ROUNDS=100
NODE_ENV=development

# Validación de JWT de Cognito (access_token) para los guards de presentation/auth/. Deben
# apuntar al mismo User Pool / App Client que usa el frontend (COGNITO_CLIENT_ID = el mismo
# valor que COGNITO_CLIENT_ID del .env del frontend).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Usuario IAM con permisos CRUD/list sobre el bucket S3 donde se almacenan los PDFs de los
# planes nutricionales (carpetas productos-personalizados/ y productos-estandarizados/).
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Habilita POST /api/v1/dev/orders/:id/simulate-payment (pago simulado). Mientras no haya una
# pasarela real (Transbank) es el único camino de pago: dejarlo en true también en producción.
# Con cualquier otro valor el endpoint responde 404.
ENABLE_PAYMENT_SIMULATION=true
